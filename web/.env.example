# Backend base URL as seen from the Next.js server (SSR and the /api/v1 proxy).
API_URL=http://localhost:8080/api/v1

# Sign-in (read per request, no rebuild needed). The Google button appears only when its client id is set.
# Google: OAuth client of type "Web application"; the same id must be in the backend's GOOGLE_CLIENT_IDS.
GOOGLE_CLIENT_ID=
# The dev sign-in form (needs the backend dev profile): shown in `npm run dev`, hidden in production unless "true".
DEV_LOGIN=
